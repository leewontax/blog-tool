# Anthropic(Claude) API 키 — https://console.anthropic.com 에서 발급
# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. .env 는 깃에 올라가지 않습니다.
ANTHROPIC_API_KEY=
# 접속 포트(선택)
PORT=3000

# (선택) 네이버 데이터랩 검색 추이 — 넣으면 추천 주제에 실제 검색 추이 그래프가 표시됩니다
# 발급: 네이버 개발자센터(developers.naver.com) → 애플리케이션 등록 → 사용 API '데이터랩(검색어트렌드)'
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (선택) 추천 주제 자동 갱신 간격(시간). 기본 12
TOPIC_REFRESH_HOURS=12
