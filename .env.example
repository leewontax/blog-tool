# 이 파일을 .env 로 복사해서 씁니다. .env 는 깃에 올라가지 않습니다.
# .env 가 없어도 프로그램은 정상 작동합니다(요청문 복사 방식, 추가 비용 없음).

# ⚠ 아래 API 키를 넣으면 버튼 한 번으로 바로 작성되지만, 사용한 만큼 Anthropic API 요금이 나옵니다.
# 추가 비용을 원하지 않으면 비워 두세요.
ANTHROPIC_API_KEY=
# 접속 포트(선택)
PORT=3000

# (선택·무료) 네이버 키 — 넣으면 추천 주제에 실제 검색 추이 그래프가 표시되고, 지역 뉴스도 네이버 뉴스에서 찾습니다
# 발급: 네이버 개발자센터(developers.naver.com) → 애플리케이션 등록 → 사용 API '데이터랩(검색어트렌드)'와 '검색' 선택
# 비워 두면 지역 뉴스는 구글 뉴스 RSS(무료)에서 찾습니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (API 키를 넣은 경우에만) 추천 주제 자동 갱신 간격(시간). 기본 12
TOPIC_REFRESH_HOURS=12
